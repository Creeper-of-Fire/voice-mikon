<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VmNext.TokenCheck</RootNamespace>
    <AssemblyName>VmNext.TokenCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      引用 VmNext.Ui 是为了直接比对 **真正在跑的那两张 palette**
      （CapsuleTheme.DarkPalette / LightPalette），而不是抄一份副本 —— 抄的副本会漂移。
      VmNext.Ui 是类库，被引用只是拿它的托管程序集。
    -->
    <ProjectReference Include="..\..\src\VmNext.Ui\VmNext.Ui.csproj" />
  </ItemGroup>

</Project>
