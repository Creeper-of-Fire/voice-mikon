<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoiceMikonCSharp.Ui.Tests.TestApp">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- 胶囊的 palette 与派生色：与正式版、demo 引同一份。 -->
        <ResourceInclude Source="avares://VoiceMikonCSharp.Ui/CapsuleTheme.axaml" />
        <!-- 面板的 palette 与控件模板：与正式版引同一份。 -->
        <ResourceInclude Source="avares://VoiceMikonCSharp.Ui/PanelTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
