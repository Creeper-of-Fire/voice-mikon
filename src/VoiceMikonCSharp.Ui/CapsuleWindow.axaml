<shell:OverlayWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:shell="using:VoiceMikonCSharp.Shell"
                      xmlns:capsule="using:VoiceMikonCSharp.Ui"
                      x:Class="VoiceMikonCSharp.Ui.CapsuleWindow"
                      Title="voice-mikon 胶囊"
                      FontFamily="Segoe UI, Microsoft YaHei"
                      FontSize="13">

  <!-- 根容器 = capsule.html 的 <body>。
       背景必须透明（CSS: html/body 背景必须 transparent，否则透明窗口会铺一块底色）。

       ⚠ 窗口尺寸**固定** 512×190（逻辑像素），SizeToContent=Manual：
       球固定待在窗口的**底边居中**（placement.py 的模块说明），
       宽度一变球就会横向跑位；而高度一变（文字条出现/变长）球就会在屏幕上跑位。
       真机 voice-mikon 的 host/capsule.py 用的就是固定 512×260 的窗口 ——
       窗口尺寸**不参与视觉**（内容自己在窗口里排），窗口只负责"往哪摆"和"裁哪块"。
       190 = 10（stack 上内边距）+ 120（文字条 max-height）+ 10（文字条下外边距）
             + 40（胶囊高）+ 10（stack 下内边距）。 -->
  <Grid Name="Root" Width="512" Height="190">

    <!-- ==================== .stack ====================
         CSS: .stack { display:flex; flex-direction:column; justify-content:flex-end;
                       height:100%; padding:10px 8px; }
         → 内容贴窗口底排；左右 8px、上下 10px 的留白（placement.py 的 ORB_INSET_Y = 10
         就是这 10px 的下留白：球的下边到窗口下边 10 逻辑像素）。
         行高：文字条区（*=120）+ 间隙 10 + 胶囊 40 = 170 = 190 − 上下各 10。 -->
    <Border Name="StackFrame"
            Padding="8,10,8,10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <Grid Name="Stack">
        <Grid.RowDefinitions>
          <!-- 文字条区（CSS .textbar 的 max-height:120px） -->
          <RowDefinition Height="*" />
          <!-- 文字条与胶囊之间的间隙（CSS .textbar { margin: 0 auto 10px }） -->
          <RowDefinition Height="10" />
          <!-- 胶囊（CSS .recording-pill { height: 40px }） -->
          <RowDefinition Height="40" />
        </Grid.RowDefinitions>

      <!-- ==================== .textbar ====================
           CSS: .textbar { width:fit-content; max-width:480px; min-width:96px;
                           margin:0 auto 10px; padding:10px 14px; border-radius:14px;
                           max-height:120px; overflow-y:auto; font-size:14px; line-height:1.8; }
           Avalonia 侧：Width=Auto + MaxWidth/MinWidth 就是 fit-content；
           MaxHeight=120 让内容超出时内部滚动（ScrollViewer）。
           ⚠ Padding 的顺序是 左,上,右,下：CSS 的 padding:10px 14px 是"上下 10、左右 14"，
           所以这里写 14,10,14,10。

           文字条是**Avalonia 文本引擎**（SelectableTextBlock）—— 框选、复制
           都走原生实现，不自己画。 -->
      <Border Name="TextBar"
              Grid.Row="0"
              MinWidth="96"
              MaxWidth="480"
              MaxHeight="120"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Padding="14,10,14,10"
              CornerRadius="14"
              ClipToBounds="True"
              Background="{DynamicResource Capsule.Textbar.Background.Brush}"
              BorderBrush="{DynamicResource Capsule.Textbar.Border.Brush}"
              BorderThickness="1">

        <Grid Name="TextBarGrid">
          <Grid.RowDefinitions>
            <!-- 报告行：CSS 的 position:sticky 在 Avalonia 没有直接对应，
                 这里把它放在 ScrollViewer **外面**固定在顶部（正文再长也看得见失败原因）。 -->
            <RowDefinition Height="Auto" />
            <!-- 分隔线：CSS 的 .textbar.has-report .textbar-report 的 border-bottom -->
            <RowDefinition Height="Auto" />
            <!-- 正文：内部滚动 -->
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 失败报告（CSS: .textbar-report）。不滚动的部分。
               TextBlock 没有 BorderBrush，用 Border 承载那条分隔线
               （CSS: .textbar.has-report .textbar-report { padding-bottom:6px;
               margin-bottom:8px; border-bottom:1px solid var(css.warn-stroke); }）。 -->
          <Border Name="TextReportFrame"
                  Grid.Row="0"
                  IsVisible="False"
                  Padding="0,0,0,6"
                  Margin="0,0,0,8"
                  BorderBrush="{DynamicResource Capsule.WarnStroke.Brush}"
                  BorderThickness="0,0,0,1">
            <TextBlock Name="TextReport"
                       FontSize="14"
                       LineHeight="25.2"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Capsule.Textbar.Foreground.Brush}" />
          </Border>

          <!-- 正文（CSS: .textbar-text，white-space:pre-wrap → Avalonia 的 TextBlock 保留换行符）。 -->
          <ScrollViewer Name="TextBodyScroll"
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Background="Transparent">
            <SelectableTextBlock Name="TextBody"
                                 FontSize="14"
                                 LineHeight="25.2"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource Capsule.Textbar.Foreground.Brush}" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ==================== .recording-pill ====================
           CSS: .recording-pill { display:flex; align-items:center; gap:8px; position:relative;
                                  width:fit-content; max-width:480px; min-width:40px; height:40px;
                                  padding:4px; border-radius:999px; overflow:hidden; }

           这里换成**自绘控件** <capsule:PillShape/>：胶囊的形状、宽度、波形、图标、
           计时与状态文字全在它自己的 Render 里按 CSS 的坐标画 ——
           不用 Grid/Canvas/Measure 去"拟合" CSS 的 fit-content（拟合不准）。
           形变 = 它的 Width 属性上挂的 800ms 过渡（CSS: max-width .8s）。

           色刷用 DynamicResource 传进去：主题补间是**就地改 brush.Color**，
           控件自己盯着 brush 的变化重绘（见 PillShape.WatchBrushes）。 -->
      <capsule:PillShape Name="Pill"
                          Grid.Row="2"
                          Width="40"
                          Height="40"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          PillBackground="{DynamicResource Capsule.Pill.Background.Brush}"
                          PillBorderBrush="{DynamicResource Capsule.Pill.Border.Brush}"
                          PillForeground="{DynamicResource Capsule.Pill.Foreground.Brush}"
                          LabelForeground="{DynamicResource Capsule.Label.Foreground.Brush}"
                          TimerForeground="{DynamicResource Capsule.Dim2.Brush}"
                          WaveBrush="{DynamicResource Capsule.Wave.Brush}"
                          WaveDimBrush="{DynamicResource Capsule.WaveDim.Brush}"
                          CancelButtonBackground="{DynamicResource Capsule.CancelBtn.Brush}"
                          CancelButtonForeground="{DynamicResource Capsule.Fg.Brush}"
                          StopButtonBackground="{DynamicResource Capsule.Wave.Brush}"
                          StopButtonForeground="{DynamicResource Capsule.WaveFg.Brush}"
                          StateIconBackground="{DynamicResource Capsule.StateIcon.Background.Brush}"
                          StateIconForeground="{DynamicResource Capsule.StateIcon.Foreground.Brush}"
                          CopyButtonBackground="{DynamicResource Capsule.StateBg.Brush}"
                          CopyButtonForeground="{DynamicResource Capsule.Fg.Brush}" />
      </Grid>
    </Border>

    <!-- ==================== .orb-menu ====================
         CSS: .orb-menu { position:absolute; bottom:58px; ... display:flex; gap:8px; padding:8px;
                          border-radius:12px; opacity:0; transition: opacity .12s ease; }
         底部 58px = 球顶距窗底 50px（190 − 10 − 40 之下再减去球的 40）+ 8px 的间隙。
         菜单与气泡**静态叠放**在同一个 Grid cell（球形态下文字条不占位，
         菜单就紧贴在球上方），不做任何回流。 -->
    <Border Name="OrbMenu"
            IsVisible="False"
            Opacity="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,58"
            Padding="8"
            CornerRadius="12"
            Background="{DynamicResource Capsule.Deep.Brush}"
            BorderBrush="{DynamicResource Capsule.Stroke.Brush}"
            BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <!-- 设置（K5 的面板还没做：点了发一条"面板尚未实现"的通知） -->
        <Button x:Name="SettingsMenuButton"
                Theme="{StaticResource Capsule.MenuButton}"
                Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                Cursor="Hand">
          <!-- 设置（SVG: gear + circle r=3），17×17 -->
          <Path Width="17" Height="17" Stretch="Uniform"
                Stroke="{DynamicResource Capsule.Fg.Brush}"
                StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12a3 3 0 1 1-6 0a3 3 0 0 1 6 0z" />
        </Button>
        <!-- 二维码扫描（附属工具：独立进程，见 companions/QrScanner） -->
        <Button x:Name="QrMenuButton"
                Theme="{StaticResource Capsule.MenuButton}"
                Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                Cursor="Hand"
                ToolTip.Tip="二维码扫描">
          <!-- 二维码（SVG: 三个 rect + 8 条 path），17×17 -->
          <Path x:Name="QrMenuIcon" Width="17" Height="17" Stretch="Uniform"
                Stroke="{DynamicResource Capsule.Fg.Brush}"
                StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                Data="M4 3h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M17 3h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M4 16h3a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1z M21 16h-3a2 2 0 0 0-2 2v3 M21 21v.01 M12 7v3a1 1 0 0 1-2 2H7 M3 12h.01 M12 3h.01 M12 16v.01 M16 12h1 M21 12v.01 M12 21v-1" />
        </Button>
        <!-- 退出 -->
        <Button x:Name="QuitMenuButton"
                Theme="{StaticResource Capsule.MenuButton}"
                Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                Cursor="Hand">
          <!-- 退出（SVG: M18.36 6.64a9 9 0 1 1-12.73 0 + 竖线 12,2→12,12），17×17 -->
          <Path Width="17" Height="17" Stretch="Uniform"
                Stroke="{DynamicResource Capsule.Fg.Brush}"
                StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                Data="M18.36 6.64a9 9 0 1 1-12.73 0 M12 2 L12 12" />
        </Button>
      </StackPanel>
    </Border>

    <!-- ==================== .orb-hint ====================
         CSS: .orb-hint { position:absolute; bottom:58px; ... padding:6px 12px;
                          border-radius:999px; opacity:0; transition: opacity .18s ease; }
         与 .orb-menu 占同一个位置（球顶 + 8px），二者互斥。 -->
    <Border Name="OrbHint"
            IsVisible="False"
            Opacity="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,58"
            Padding="12,6,12,6"
            CornerRadius="14"
            Background="{DynamicResource Capsule.Deep.Brush}"
            BorderBrush="{DynamicResource Capsule.Stroke.Brush}"
            BorderThickness="1">
      <TextBlock Name="OrbHintText"
                 FontSize="12"
                 LineHeight="16.8"
                 Foreground="{DynamicResource Capsule.Fg.Brush}" />
    </Border>
  </Grid>
</shell:OverlayWindow>
