<shell:OverlayWindow xmlns="https://github.com/avaloniaui"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:shell="using:VmNext.Shell"
                      x:Class="VmNext.Ui.CapsuleWindow"
                      Title="voice-mikon 胶囊"
                      FontFamily="Segoe UI, Microsoft YaHei"
                      FontSize="13">

  <!-- 根容器 = capsule.html 的 <body>。
       背景必须透明（CSS: html/body 背景必须 transparent，否则透明窗口会铺一块底色）。 -->
  <Grid Name="Root" Background="Transparent">

    <!-- ==================== .stack ====================
         CSS: .stack { display:flex; flex-direction:column; justify-content:flex-end;
                       height:100%; padding:10px 8px; }
         → 内容贴窗口底排；左右 8px、上下 10px 的留白（placement.py 的 ORB_INSET_Y = 10
         就是这 10px 的下留白：球的下边到窗口下边 10 逻辑像素）。

         ⚠ 窗口宽度是**固定**的（voice-mikon 的 host/capsule.py WIN_W = 512）：
         球固定待在窗口的**底边居中**（placement.py 的模块说明），
         宽度一变球就会横向跑位 —— 真机正是靠"窗口定宽 + 内容居中"保证
         球↔胶囊形变时轨迹严丝合缝。窗口高度跟着内容走。 -->
    <Border Name="StackFrame"
            Padding="8,10,8,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
    <StackPanel Name="Stack"
                Orientation="Vertical"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">

      <!-- ==================== .orb-hint ====================
           CSS: .orb-hint { position:absolute; bottom:58px; ... }
           bottom 58px = 球顶（距窗底 50px）+ 8px 间隙。
           这里放进纵向流里、放在胶囊**正上方**（下留白 8px），
           效果与 CSS 一致：球在底边、气泡紧贴在球上方。 -->
      <Border Name="OrbHint"
              IsVisible="False"
              Opacity="0"
              Margin="0,0,0,8"
              Padding="6,12"
              CornerRadius="999"
              Background="{DynamicResource Capsule.Deep.Brush}"
              BorderBrush="{DynamicResource Capsule.Stroke.Brush}"
              BorderThickness="1">
        <TextBlock Name="OrbHintText"
                   FontSize="12"
                   LineHeight="16.8"
                   Foreground="{DynamicResource Capsule.Fg.Brush}" />
      </Border>

      <!-- ==================== .orb-menu ====================
           CSS: .orb-menu { position:absolute; bottom:58px; ... display:flex; gap:8px; padding:8px; }
           与 .orb-hint 占同一个位置（球顶 + 8px），二者互斥。 -->
      <Border Name="OrbMenu"
              IsVisible="False"
              Opacity="0"
              Margin="0,0,0,8"
              Padding="8"
              CornerRadius="12"
              Background="{DynamicResource Capsule.Deep.Brush}"
              BorderBrush="{DynamicResource Capsule.Stroke.Brush}"
              BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <!-- 设置（K5 的面板还没做：点了发一条"面板尚未实现"的通知） -->
          <Button x:Name="SettingsMenuButton"
                  Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                  Background="{DynamicResource Capsule.StateBg.Brush}">
            <Path Width="17" Height="17" Stretch="Uniform"
                  Stroke="{DynamicResource Capsule.Fg.Brush}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 1 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l-.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 0-2-2 2 2 0 0 0-2 2v.18a2 2 0 0 1 1 1.73l.43.25a2 2 0 0 1 2 0l.15-.08a2 2 0 0 0 2.73.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z M15 12 A3 3 0 1 1 9 12 A3 3 0 1 1 15 12 Z" />
          </Button>
          <!-- 二维码扫描（附属工具：独立进程，见 companions/QrScanner） -->
          <Button x:Name="QrMenuButton"
                  Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                  Background="{DynamicResource Capsule.StateBg.Brush}"
                  ToolTip.Tip="二维码扫描">
                  <Path x:Name="QrMenuIcon" Width="17" Height="17" Stretch="Uniform"
                        Stroke="{DynamicResource Capsule.Fg.Brush}"
                        StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                        Data="M4 3 H7 A1 1 0 0 1 8 4 V7 A1 1 0 0 1 7 8 H4 A1 1 0 0 1 3 7 V4 A1 1 0 0 1 4 3 Z M17 3 H20 A1 1 0 0 1 21 4 V7 A1 1 0 0 1 20 8 H17 A1 1 0 0 1 16 7 V4 A1 1 0 0 1 17 3 Z M4 16 H7 A1 1 0 0 1 8 17 V20 A1 1 0 0 1 7 21 H4 A1 1 0 0 1 3 20 V17 A1 1 0 0 1 4 16 Z M21 16 H18 A2 2 0 0 0 16 18 V21 M21 21 V21.01 M12 7 V10 A2 2 0 0 1 10 12 H7 M3 12 H3.01 M12 3 H12.01 M12 16 V16.01 M16 12 H17 M21 12 V12.01 M12 21 V20" />
          </Button>
          <!-- 退出 -->
          <Button x:Name="QuitMenuButton" Width="34" Height="34" Padding="0" CornerRadius="17" BorderThickness="0"
                  Background="{DynamicResource Capsule.StateBg.Brush}">
            <Path Width="17" Height="17" Stretch="Uniform"
                  Stroke="{DynamicResource Capsule.Fg.Brush}"
                  StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Data="M18.36 6.64a9 9 0 1 1-12.73 0 M12 2 L12 12" />
          </Button>
        </StackPanel>
      </Border>

      <!-- ==================== .textbar ====================
           CSS: .textbar { width:fit-content; max-width:480px; min-width:96px;
                           margin:0 auto 10px; padding:10px 14px; border-radius:14px;
                           max-height:120px; overflow-y:auto; font-size:14px; line-height:1.8; }
           Avalonia 侧：Width=Auto + MaxWidth/MinWidth 就是 fit-content；
           MaxHeight=120 让内容超出时内部滚动（ScrollViewer）。 -->
      <Border Name="TextBar"
              MinWidth="96"
              MaxWidth="480"
              MaxHeight="120"
              Margin="0,0,0,10"
              Padding="10,14"
              HorizontalAlignment="Center"
              CornerRadius="14"
              ClipToBounds="True"
              Background="{DynamicResource Capsule.Textbar.Background.Brush}"
              BorderBrush="{DynamicResource Capsule.Textbar.Border.Brush}"
              BorderThickness="1">

        <Grid Name="TextBarGrid">
          <Grid.RowDefinitions>
            <!-- 报告行：CSS 的 position:sticky 在 Avalonia 没有直接对应，
                 这里把它放在 ScrollViewer **外面**固定在顶部（正文再长也看得见失败原因）。 -->
            <RowDefinition Height="Auto" />
            <!-- 分隔线：CSS 的 .textbar.has-report .textbar-report 的 border-bottom -->
            <RowDefinition Height="Auto" />
            <!-- 正文：内部滚动 -->
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- 失败报告（CSS: .textbar-report）。不滚动的部分。
               TextBlock 没有 BorderBrush，用 Border 承载那条分隔线
               （CSS: .textbar.has-report .textbar-report { padding-bottom:6px;
               margin-bottom:8px; border-bottom:1px solid var(css.warn-stroke); }）。 -->
          <Border Name="TextReportFrame"
                  Grid.Row="0"
                  IsVisible="False"
                  Padding="0,0,0,6"
                  Margin="0,0,0,8"
                  BorderBrush="{DynamicResource Capsule.WarnStroke.Brush}"
                  BorderThickness="0,0,0,1">
            <TextBlock Name="TextReport"
                       FontSize="14"
                       LineHeight="25.2"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Capsule.Textbar.Foreground.Brush}" />
          </Border>

          <!-- 正文（CSS: .textbar-text，white-space:pre-wrap → Avalonia 的 TextBlock 保留换行符）。 -->
          <ScrollViewer Name="TextBodyScroll"
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Background="Transparent">
            <SelectableTextBlock Name="TextBody"
                                 FontSize="14"
                                 LineHeight="25.2"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource Capsule.Textbar.Foreground.Brush}" />
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- ==================== .recording-pill ====================
           CSS: .recording-pill { display:flex; align-items:center; gap:8px; position:relative;
                                  width:fit-content; max-width:480px; min-width:40px; height:40px;
                                  padding:4px; border-radius:999px; overflow:hidden; }
           MaxWidth 从 40（球）过渡到 480（胶囊），宽度 = min(内容宽, MaxWidth)，
           视觉上就是"一点点长开"（过渡在代码里设，见 CapsuleWindow.axaml.cs）。 -->
      <Border Name="Pill"
              Height="40"
              MinWidth="40"
              MaxWidth="40"
              Padding="4"
              HorizontalAlignment="Center"
              CornerRadius="20"
              ClipToBounds="True"
              Background="{DynamicResource Capsule.Pill.Background.Brush}"
              BorderBrush="{DynamicResource Capsule.Pill.Border.Brush}"
              BorderThickness="1">

        <Grid Name="PillGrid" ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <!-- cancel 按钮 -->
            <ColumnDefinition Width="Auto" />
            <!-- .bar-content（波形 / 状态文字 / 计时） -->
            <ColumnDefinition Width="Auto" />
            <!-- 结束钮 或 状态图标 -->
            <ColumnDefinition Width="Auto" />
            <!-- 复制按钮（只在带原文的错误/警告态出现） -->
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- ==================== .bar-orb ====================
               CSS: .bar-orb { position:absolute; inset:0; display:grid; place-items:center;
                               color:var(css.wave-fg); opacity:0; }
               悬浮球**不是另一个元素**：它就是这颗胶囊收起来的样子（40px 的正圆）。
               这里让它横跨整颗胶囊并居中 —— 落在胶囊的几何中心上。 -->
          <Panel Name="OrbHost" Grid.Column="0" Grid.ColumnSpan="4">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
              <!-- 麦克风（CSS: svg.orb-mic，20x20 / viewBox 24x24 / stroke-width 2） -->
              <Path Name="OrbMicIcon"
                    Width="20"
                    Height="20"
                    Stretch="Uniform"
                    Stroke="{DynamicResource Capsule.WaveFg.Brush}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Data="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z M19 10v2a7 7 0 0 1-14 0v-2 M12 19 L12 22" />

              <!-- 模型加载中：球上转圈（CSS: svg.orb-loader，1.1s linear infinite） -->
              <Path Name="OrbLoaderIcon"
                    Width="20"
                    Height="20"
                    Stretch="Uniform"
                    IsVisible="False"
                    Stroke="{DynamicResource Capsule.WaveFg.Brush}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Data="M21 12a9 9 0 1 1-6.219-8.56" />
            </Grid>
          </Panel>

          <!-- ==================== 取消按钮 ====================
               CSS: .recording-pill button { width:30px; height:30px; border-radius:50%; }
               CSS: .recording-pill .bar-cancel { background:var(css.cancel-btn); color:var(css.fg); } -->
          <Button Name="CancelButton"
                  Grid.Column="0"
                  Width="30"
                  Height="30"
                  Padding="0"
                  CornerRadius="15"
                  BorderThickness="0"
                  Background="{DynamicResource Capsule.CancelBtn.Brush}"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <Path Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Capsule.Fg.Brush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M18 6 6 18 M6 6 18 18" />
          </Button>

          <!-- ==================== .bar-content ====================
               CSS: .bar-content { display:flex; align-items:center; justify-content:center;
                                   min-width:0; padding:0 2px; } -->
          <StackPanel Name="BarContent"
                      Grid.Column="1"
                      Orientation="Horizontal"
                      VerticalAlignment="Center"
                      Margin="0,0,2,0">

            <!-- 波形区：13 根滚动电平条（CSS: .waveform，75x24，左侧 10px 用 mask 渐隐）。
                 渐变用 OpacityMask —— CSS 注释里说明了为什么不能用"盖一块底色"的办法：
                 盖子的颜色是静态的，球展开成胶囊时底色正从红褪成深，红底上会凭空多出一块深色渐变块。 -->
            <Border Name="Waveform"
                    Width="75"
                    Height="24"
                    ClipToBounds="True"
                    VerticalAlignment="Center">
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <!-- CSS: linear-gradient(90deg, transparent 0%, #000 10px) → 10/75 = 0.1333 -->
                  <GradientStop Offset="0" Color="#00000000" />
                  <GradientStop Offset="0.1333" Color="#FF000000" />
                  <GradientStop Offset="1" Color="#FF000000" />
                </LinearGradientBrush>
              </Border.OpacityMask>
              <Canvas Name="WaveCanvas" Width="75" Height="24" />
            </Border>

            <!-- 状态文字（CSS: .bar-label，max-width 180px，13px/500，超出省略号） -->
            <TextBlock Name="BarLabel"
                       MaxWidth="180"
                       Padding="4,0,4,1"
                       FontSize="13"
                       FontWeight="Medium"
                       IsVisible="False"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Capsule.Label.Foreground.Brush}" />

            <!-- 计时（CSS: .bar-timer，mono 字体 12px，dim2 色） -->
            <TextBlock Name="BarTimer"
                       Padding="4,0"
                       FontFamily="Cascadia Mono, Consolas"
                       FontSize="12"
                       IsVisible="False"
                       VerticalAlignment="Center"
                       Text="0:00"
                       Foreground="{DynamicResource Capsule.Dim2.Brush}" />
          </StackPanel>

          <!-- ==================== 结束钮 ====================
               CSS: .recording-pill .bar-stop { background:var(css.wave); color:var(css.wave-fg); } -->
          <Button Name="StopButton"
                  Grid.Column="2"
                  Width="30"
                  Height="30"
                  Padding="0"
                  CornerRadius="15"
                  BorderThickness="0"
                  IsVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Capsule.Wave.Brush}">
            <Path Width="17"
                  Height="17"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Capsule.WaveFg.Brush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M20 6 9 17 4 12" />
          </Button>

          <!-- ==================== .bar-state ====================
               CSS: .bar-state { width:30px; height:30px; border-radius:50%;
                                 background:var(css.state-bg); color:var(css.wave); }
               三个图标按阶段切换（CSS: .bar-state svg { display:none } + 各 phase 的规则）。 -->
          <Border Name="StateIcon"
                  Grid.Column="2"
                  Width="30"
                  Height="30"
                  CornerRadius="15"
                  IsVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Capsule.StateIcon.Background.Brush}">
            <Grid>
              <!-- 处理中 / 已取消：转圈 -->
              <Path Name="StateLoaderIcon"
                    Width="16"
                    Height="16"
                    Stretch="Uniform"
                    IsVisible="False"
                    Stroke="{DynamicResource Capsule.StateIcon.Foreground.Brush}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Data="M21 12a9 9 0 1 1-6.219-8.56" />
              <!-- 完成：对勾 -->
              <Path Name="StateCheckIcon"
                    Width="16"
                    Height="16"
                    Stretch="Uniform"
                    IsVisible="False"
                    Stroke="{DynamicResource Capsule.StateIcon.Foreground.Brush}"
                    StrokeThickness="2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    Data="M20 6 9 17 4 12" />
              <!-- 出错：感叹号（CSS 里是 circle + 两条线） -->
              <Grid Name="StateInfoIcon" IsVisible="False">
                <Ellipse Width="16"
                         Height="16"
                         Stroke="{DynamicResource Capsule.StateIcon.Foreground.Brush}"
                         StrokeThickness="2" />
                <Path Width="16"
                      Height="16"
                      Stretch="Uniform"
                      Data="M12 16 L12 12 M12 8 L12.01 8"
                      Stroke="{DynamicResource Capsule.StateIcon.Foreground.Brush}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeJoin="Round" />
              </Grid>
            </Grid>
          </Border>

          <!-- ==================== 复制按钮 ====================
               CSS: .recording-pill.error.can-copy .bar-copy,
               .recording-pill.warning.can-copy .bar-copy { display:grid;
                 background:var(css.state-bg); color:var(css.fg); } -->
          <Button Name="CopyButton"
                  Grid.Column="3"
                  Width="30"
                  Height="30"
                  Padding="0"
                  CornerRadius="15"
                  BorderThickness="0"
                  IsVisible="False"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Background="{DynamicResource Capsule.StateBg.Brush}">
            <Path Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Stroke="{DynamicResource Capsule.Fg.Brush}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Data="M11 9 H20 A2 2 0 0 1 22 11 V20 A2 2 0 0 1 20 22 H11 A2 2 0 0 1 9 20 V11 A2 2 0 0 1 11 9 Z M5 15 H4 A2 2 0 0 1 2 13 V4 A2 2 0 0 1 4 2 H13 A2 2 0 0 1 15 4 V5" />
          </Button>
        </Grid>
      </Border>
    </StackPanel>
    </Border>
  </Grid>
</shell:OverlayWindow>
