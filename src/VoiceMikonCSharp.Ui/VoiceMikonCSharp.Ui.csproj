<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>VoiceMikonCSharp.Ui</RootNamespace>
    <AssemblyName>VoiceMikonCSharp.Ui</AssemblyName>
    <!-- AOT 友好：默认编译期绑定，避免运行时反射查控件 -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!--
      版本用 11.* 浮动（与 src/VoiceMikonCSharp.Shell 保持一致）。
      正式发布前应锁定具体版本（archive 意外发现 #9）。
    -->
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI 层只依赖 core（显示协议 / presenter）与 shell（窗口层 / 主题机制） -->
    <ProjectReference Include="..\VoiceMikonCSharp.Core\VoiceMikonCSharp.Core.csproj" />
    <ProjectReference Include="..\VoiceMikonCSharp.Shell\VoiceMikonCSharp.Shell.csproj" />
  </ItemGroup>

</Project>
