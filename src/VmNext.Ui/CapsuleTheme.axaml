<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== 令牌（深色基准）====================
       值逐字来自 voice-mikon/src/voice_mikon/host/static/capsule.css 的 :root 块。
       ⚠ CSS 的 8 位十六进制是 #RRGGBBAA（alpha 在**最后**），
         这里已按 CSS 规范换算成 Avalonia 的 #AARRGGBB。
       换算说明见 docs/k4a-ui.md 的"疑问清单"第 1 条。
       注：注释里的 css.xxx 指的是 capsule.css 的 CSS 变量（双连字符前缀）——
           XML 注释里不允许出现连续两个连字符，所以这里写成 css. 形式。 -->

  <!-- css.deep: #0b0b0c  卡片底色（文字条 + 胶囊） -->
  <SolidColorBrush x:Key="Capsule.Deep.Brush" Color="#FF0B0B0C" />
  <!-- css.fg: #f4f4f5  前景字色 -->
  <SolidColorBrush x:Key="Capsule.Fg.Brush" Color="#FFF4F4F5" />
  <!-- css.stroke: #ffffff33  描边（白 20% 透明） -->
  <SolidColorBrush x:Key="Capsule.Stroke.Brush" Color="#33FFFFFF" />
  <!-- css.err-bg: #2a0f11  错误态底色 -->
  <SolidColorBrush x:Key="Capsule.ErrBg.Brush" Color="#FF2A0F11" />
  <!-- css.err-stroke: #ff6b6b4d  错误态描边（红 30% 透明） -->
  <SolidColorBrush x:Key="Capsule.ErrStroke.Brush" Color="#4DFF6B6B" />
  <!-- css.err-fg: #fecaca  错误态文字 -->
  <SolidColorBrush x:Key="Capsule.ErrFg.Brush" Color="#FFFECACA" />
  <!-- css.err-icon: #fca5a5  错误态图标 -->
  <SolidColorBrush x:Key="Capsule.ErrIcon.Brush" Color="#FFFCA5A5" />
  <!-- css.warn-bg: #2a1f0b  警告态底色（琥珀，不是错误红） -->
  <SolidColorBrush x:Key="Capsule.WarnBg.Brush" Color="#FF2A1F0B" />
  <!-- css.warn-stroke: #fbbf244d  警告态描边 -->
  <SolidColorBrush x:Key="Capsule.WarnStroke.Brush" Color="#4DFBBF24" />
  <!-- css.warn-fg: #fde68a  警告态文字 -->
  <SolidColorBrush x:Key="Capsule.WarnFg.Brush" Color="#FFFDE68A" />
  <!-- css.warn-icon: #fcd34d  警告态图标 -->
  <SolidColorBrush x:Key="Capsule.WarnIcon.Brush" Color="#FFFCD34D" />
  <!-- css.cancel-btn: #3a3a3e  取消按钮底色 -->
  <SolidColorBrush x:Key="Capsule.CancelBtn.Brush" Color="#FF3A3A3E" />
  <!-- css.cancel-btn-hover: #4a4a4f  取消按钮悬停底色 -->
  <SolidColorBrush x:Key="Capsule.CancelBtnHover.Brush" Color="#FF4A4A4F" />
  <!-- css.state-bg: #ffffff14  状态图标圆的底 -->
  <SolidColorBrush x:Key="Capsule.StateBg.Brush" Color="#14FFFFFF" />
  <!-- css.wave-fg: #0b0b0c  红色块上的字色（结束钮 / 完成圆钮） -->
  <SolidColorBrush x:Key="Capsule.WaveFg.Brush" Color="#FF0B0B0C" />
  <!-- css.dim: rgba(244,244,245,.5)  空态占位文字 -->
  <SolidColorBrush x:Key="Capsule.Dim.Brush" Color="#80F4F4F5" />
  <!-- css.dim2: rgba(244,244,245,.7)  计时 -->
  <SolidColorBrush x:Key="Capsule.Dim2.Brush" Color="#B3F4F4F5" />
  <!-- css.dim3: rgba(244,244,245,.65)  取消态文字 -->
  <SolidColorBrush x:Key="Capsule.Dim3.Brush" Color="#A6F4F4F5" />
  <!-- css.wave: #ff5a5a  录音红（两套主题一样 —— 红是语义色，不是主题色） -->
  <SolidColorBrush x:Key="Capsule.Wave.Brush" Color="#FFFF5A5A" />
  <!-- css.wave-dim: rgba(244,244,245,.28)  波形里的静音条 -->
  <SolidColorBrush x:Key="Capsule.WaveDim.Brush" Color="#47F4F4F5" />
  <!-- 结束钮 hover：CSS 的 .bar-stop:hover { filter: brightness(.92) }。
       透明窗口上不能用 filter（会造出离屏合成层），所以换成"稍深的红"：
       #ff5a5a × 0.92 = #eb5353。css.wave 两套主题一样，这个值也跟着一样。 -->
  <SolidColorBrush x:Key="Capsule.WaveHover.Brush" Color="#FFEB5353" />

  <!-- ==================== 派生色 ====================
       这些不是 CSS 令牌：它们的值由「当前形态 + 当前阶段 + 当前主题」算出来
       （例如胶囊底色在球形态是录音红、在错误态是 err-bg、在展开态是 deep）。
       所以它们不能挂在 palette 上，只能由 CapsuleTheme 在状态变化时重算并补间。 -->

  <!-- 胶囊底色（初始值 = 展开态 + 深色主题的 deep） -->
  <SolidColorBrush x:Key="Capsule.Pill.Background.Brush" Color="#FF0B0B0C" />
  <!-- 胶囊描边（初始值 = stroke） -->
  <SolidColorBrush x:Key="Capsule.Pill.Border.Brush" Color="#33FFFFFF" />
  <!-- 胶囊前景（初始值 = fg） -->
  <SolidColorBrush x:Key="Capsule.Pill.Foreground.Brush" Color="#FFF4F4F5" />
  <!-- 文字条底色（初始值 = deep） -->
  <SolidColorBrush x:Key="Capsule.Textbar.Background.Brush" Color="#FF0B0B0C" />
  <!-- 文字条描边（初始值 = stroke） -->
  <SolidColorBrush x:Key="Capsule.Textbar.Border.Brush" Color="#33FFFFFF" />
  <!-- 文字条前景（初始值 = fg） -->
  <SolidColorBrush x:Key="Capsule.Textbar.Foreground.Brush" Color="#FFF4F4F5" />
  <!-- 胶囊里那行状态文字的颜色（初始值 = fg） -->
  <SolidColorBrush x:Key="Capsule.Label.Foreground.Brush" Color="#FFF4F4F5" />
  <!-- 右侧状态图标圆的底色（初始值 = state-bg） -->
  <SolidColorBrush x:Key="Capsule.StateIcon.Background.Brush" Color="#14FFFFFF" />
  <!-- 右侧状态图标的颜色（初始值 = wave） -->
  <SolidColorBrush x:Key="Capsule.StateIcon.Foreground.Brush" Color="#FFFF5A5A" />

  <!-- ==================== 胶囊里的按钮 ====================
       CSS 的按钮是纯色圆钮：
         .recording-pill button { width:30px; height:30px; border-radius:50%; }
         .recording-pill .bar-cancel { background:var(css.cancel-btn); color:var(css.fg); }
         .recording-pill .bar-cancel:hover { background:var(css.cancel-btn-hover); }
         .recording-pill .bar-stop { background:var(css.wave); color:var(css.wave-fg); }
         .recording-pill .bar-stop:hover { filter: brightness(0.92); }
         .recording-pill.error.can-copy .bar-copy { background:var(css.state-bg); color:var(css.fg); }
         .recording-pill.error.can-copy .bar-copy:hover { background:var(css.cancel-btn-hover); }

       ⚠ 为什么不用 Fluent 的 Button 主题：Fluent 给按钮加了 PointerOver / Pressed 的
       底色，而球形态下胶囊里的按钮是**透明**的（CSS: opacity:0 + pointer-events:none）——
       Fluent 的高亮会在红球上"发光"，看着像凭空多出来的一个圈。
       所以这里给胶囊里的按钮用自己的 ControlTheme：自己的模板（圆角底 + 内容居中），
       不带 Fluent 的 PointerOver；hover 色按 CSS 单独给。

       ⚠ 底色**只能**由 ControlTheme 给（不能在按钮上写本地 Background）：
       本地值的优先级最高，主题里的 :pointerover 规则就压不住它了。 -->
  <ControlTheme x:Key="Capsule.IconButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- 取消钮（✕）：CSS .bar-cancel -->
  <ControlTheme x:Key="Capsule.CancelButton" TargetType="Button" BasedOn="{StaticResource Capsule.IconButton}">
    <Setter Property="Background" Value="{DynamicResource Capsule.CancelBtn.Brush}" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Capsule.CancelBtnHover.Brush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Capsule.CancelBtnHover.Brush}" />
    </Style>
  </ControlTheme>

  <!-- 结束钮（✓）：CSS .bar-stop（hover 是 brightness(.92)，见 WaveHover 那条注释） -->
  <ControlTheme x:Key="Capsule.StopButton" TargetType="Button" BasedOn="{StaticResource Capsule.IconButton}">
    <Setter Property="Background" Value="{DynamicResource Capsule.Wave.Brush}" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Capsule.WaveHover.Brush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Capsule.WaveHover.Brush}" />
    </Style>
  </ControlTheme>

  <!-- 复制钮：CSS .bar-copy -->
  <ControlTheme x:Key="Capsule.CopyButton" TargetType="Button" BasedOn="{StaticResource Capsule.IconButton}">
    <Setter Property="Background" Value="{DynamicResource Capsule.StateBg.Brush}" />
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{DynamicResource Capsule.CancelBtnHover.Brush}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{DynamicResource Capsule.CancelBtnHover.Brush}" />
    </Style>
  </ControlTheme>

  <!-- 球菜单里的圆钮：CSS .orb-menu-btn（hover 色在代码里手写，见 CapsuleWindow 的
       WireMenuButtonHover —— 退出项 hover 要换成警示色，样式表表达不了） -->
  <ControlTheme x:Key="Capsule.MenuButton" TargetType="Button" BasedOn="{StaticResource Capsule.IconButton}">
    <Setter Property="Background" Value="{DynamicResource Capsule.StateBg.Brush}" />
  </ControlTheme>

</ResourceDictionary>

